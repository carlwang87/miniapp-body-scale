.home-page {
  padding-top: 20rpx;
}

.hero {
  position: relative;
  overflow: hidden;
  height: 320rpx;
  border-radius: 8rpx;
  background: #102a43;
}

.scale-photo {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 32rpx;
  color: #fff;
  background: linear-gradient(180deg, rgba(16, 42, 67, 0) 0%, rgba(16, 42, 67, 0.82) 100%);
}

.hero-overlay .title,
.hero-overlay .subtitle {
  color: #fff;
}

.member-name,
.device-name {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.small-btn {
  width: 132rpx;
  min-height: 60rpx;
  padding: 0;
  font-size: 24rpx;
}

.primary-action {
  min-height: 100rpx;
  font-size: 34rpx;
}

.latest-time {
  margin-top: 8rpx;
  color: #334e68;
}

.metric-grid {
  margin-top: 24rpx;
}

.status-pill {
  margin-top: 14rpx;
}

.status-pill.normal {
  color: #17643b;
  background: #dcf7e7;
}

.status-pill.high,
.status-pill.low {
  color: #8a4b00;
  background: #fff4d6;
}

.status-pill.danger {
  color: #9b1c1c;
  background: #fde2e2;
}

.report {
  margin-top: 24rpx;
  color: #334e68;
  line-height: 1.7;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
}

.mini-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 220rpx;
  margin-top: 24rpx;
}

.bar-cell {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
}

.bar {
  width: 34rpx;
  min-height: 20rpx;
  border-radius: 6rpx 6rpx 0 0;
  background: #0b6bcb;
}

.bar-value {
  color: #52606d;
  font-size: 20rpx;
}

.bar-label {
  margin-top: 10rpx;
  color: #829ab1;
  font-size: 20rpx;
}
