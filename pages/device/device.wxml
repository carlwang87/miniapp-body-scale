<view class="page">
  <view class="card">
    <view class="row">
      <view>
        <view class="muted">连接状态</view>
        <view class="state-text">{{state}}</view>
      </view>
      <view class="pill {{state === '已连接' ? 'ok' : 'warn'}}">{{state}}</view>
    </view>
  </view>

  <view class="card section" wx:if="{{boundDevice}}">
    <view class="section-title">已绑定设备</view>
    <view class="device-name">{{boundDevice.deviceName}}</view>
    <view class="info-line">型号：{{boundDevice.deviceModel}}</view>
    <view class="info-line">服务：{{boundDevice.serviceUuid || '待识别'}}</view>
    <view class="info-line">Notify：{{boundDevice.notifyCharacteristicUuid || '待识别'}}</view>
    <view class="info-line">Write：{{boundDevice.writeCharacteristicUuid || '待识别'}}</view>
    <view class="info-line">Notify 数量：{{boundDevice.notifyCharacteristics ? boundDevice.notifyCharacteristics.length : 0}}</view>
    <view class="info-line">Write 数量：{{boundDevice.writeCharacteristics ? boundDevice.writeCharacteristics.length : 0}}</view>
    <view class="char-list" wx:if="{{boundDevice.characteristics && boundDevice.characteristics.length}}">
      <view class="char-item" wx:for="{{boundDevice.characteristics}}" wx:key="characteristicUuid">
        <view>{{item.serviceUuid}}</view>
        <view>{{item.characteristicUuid}}</view>
        <view class="char-props">{{item.propertyText}}</view>
      </view>
    </view>
    <view class="info-line">绑定时间：{{boundDevice.bindTimeText}}</view>
    <view class="info-line">最近连接：{{boundDevice.lastConnectedText}}</view>
    <view class="grid-2 action-grid">
      <button class="btn" bindtap="reconnectBound">重新连接</button>
      <button class="btn secondary" bindtap="disconnectBound">断开</button>
    </view>
    <button class="btn ghost section" bindtap="copyDeviceInfo">复制设备信息</button>
    <button class="btn danger section" bindtap="unbindDevice">解绑设备</button>
  </view>

  <view class="card section" wx:else>
    <view class="empty">尚未绑定体脂秤。可以先添加模拟设备跑通测量流程，再用真实设备扫描绑定。</view>
  </view>

  <view class="grid-2 section">
    <button class="btn" bindtap="startScan" wx:if="{{!scanning}}">搜索新设备</button>
    <button class="btn secondary" bindtap="stopScan" wx:else>停止搜索</button>
    <button class="btn ghost" bindtap="addMockDevice">模拟设备</button>
  </view>

  <view class="card section">
    <view class="section-title">附近设备</view>
    <view class="empty" wx:if="{{!devices.length}}">暂无扫描结果</view>
    <view class="device-item" wx:for="{{devices}}" wx:key="deviceId">
      <view class="row">
        <view class="device-main">
          <view class="device-list-name">{{item.displayName}}</view>
          <view class="muted">RSSI {{item.rssi}} · {{item.deviceId}}</view>
        </view>
        <view class="pill {{item.candidate ? 'ok' : ''}}">{{item.candidate ? '疑似 EW-FA33' : 'BLE'}}</view>
      </view>
      <view class="adv" wx:if="{{item.advertisHex}}">{{item.advertisHex}}</view>
      <button class="btn bind-btn" data-index="{{index}}" bindtap="bindDevice">连接并绑定</button>
    </view>
  </view>
</view>
