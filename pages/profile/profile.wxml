<view class="page" wx:if="{{user}}">
  <view class="card">
    <view class="row">
      <view>
        <view class="muted">微信登录态</view>
        <view class="openid">{{user.openid}}</view>
      </view>
      <button class="btn ghost small-btn" bindtap="login">登录</button>
    </view>
  </view>

  <view class="card section">
    <view class="section-title">个人资料</view>
    <view class="form-row">
      <view class="form-label">昵称 *</view>
      <input class="form-control" value="{{user.nickname}}" placeholder="昵称" data-field="nickname" bindinput="onInput" />
    </view>
    <view class="form-row">
      <view class="form-label">性别 *</view>
      <picker class="form-control" mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="onGenderChange">
        <view>{{genderOptions[genderIndex]}}</view>
      </picker>
    </view>
    <view class="form-row">
      <view class="form-label">生日 *</view>
      <picker class="form-control" mode="date" value="{{user.birthday}}" bindchange="onBirthdayChange">
        <view>{{user.birthday}}</view>
      </picker>
    </view>
    <view class="form-row">
      <view class="form-label">身高 *</view>
      <input class="form-control" type="digit" value="{{user.heightCm}}" placeholder="cm" data-field="heightCm" bindinput="onInput" />
    </view>
    <view class="form-row">
      <view class="form-label">目标体重</view>
      <input class="form-control" type="digit" value="{{user.targetWeightKg}}" placeholder="kg" data-field="targetWeightKg" bindinput="onInput" />
    </view>
    <view class="form-row remark-row">
      <view class="form-label">备注</view>
      <textarea class="form-control remark" value="{{user.remark}}" placeholder="可选" data-field="remark" bindinput="onInput"></textarea>
    </view>
    <button class="btn section" bindtap="saveProfile">保存资料</button>
  </view>

  <view class="card section">
    <view class="section-title">隐私说明</view>
    <view class="privacy">测量数据默认保存在本机。配置后端 API 后，才会上传到自有服务端。当前数据仅用于健康趋势参考，不作为医疗诊断依据。</view>
  </view>

  <button class="btn danger section" bindtap="clearData">清除本地数据</button>
</view>
